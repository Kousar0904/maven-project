pipeline {
    agent any
    triggers { pollSCM('* * * * *') }

    stages {
        stage('Build') {
            steps {
                dir('webapp') {
                    bat 'mvn clean package'
                }
            }
        }
    }

    post {
        success {
            bat 'echo %GIT_COMMIT% > "%JENKINS_HOME%\\last_good_commit.txt"'
        }
        failure {
            script {
                def f = "${env.JENKINS_HOME}\\last_good_commit.txt"
                if (fileExists(f)) {
                    def lastGood = readFile(f).trim()
                    echo "Build failed. Rolling back to ${lastGood}"
                    bat "git checkout ${lastGood}"
                    dir('webapp') {
                        bat 'mvn clean package'
                    }
                } else {
                    echo 'No previous good version saved yet'
                }
            }
        }
    }
}
